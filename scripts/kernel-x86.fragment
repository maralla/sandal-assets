# sandal x86_64 guest kernel fragment — a COMPLETE minimal config applied
# over allnoconfig (see build-kernel.sh x86_64). Base: linux 7.2.10.
#
# The VMM is a KVM userspace VMM with:
#   - PVH direct boot (ELF vmlinux, hvm_start_info) — no firmware, no ACPI
#   - virtio-mmio devices registered via the `virtio_mmio.device=` cmdline
#     parameter (no PCI bus emulation), IRQs from the legacy ISA range
#     (delivered through the in-kernel i8259 PIC)
#   - vsock as the one session transport (no console device at all); the
#     8250 serial carries earlycon for boot diagnostics
#   - ext2 (via the ext4 driver) root on /dev/vda, overlayfs upper on /dev/vdb
#   - virtiofs (FUSE) for --share directories, virtio-rng for entropy
#
# Everything not listed here stays at allnoconfig (=n). Hidden symbols keep
# their Kconfig defaults (allnoconfig can only touch visible ones), which
# covers the quietly-required plumbing (futexes, epoll, CRC helpers, ...).
#
# 7.2.10 notes:
#   - The preemption model choice defaults to PREEMPT_LAZY on x86/arm64
#     (both select ARCH_HAS_PREEMPT_LAZY); PREEMPT_NONE is not selectable.
#     The prebuilt kernel runs PREEMPT_LAZY; the integration suite passes
#     with it.
#   - Symbols that cannot be pinned off (X86_IO_APIC, IPV6, PERF_EVENTS,
#     VT, ELF_CORE) are documented per-section, with what actually happens
#     at runtime.

# ── base architecture (allnoconfig needs these spelled out) ────────────
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_EXPERT=y
# The local APIC: KVM creates a vLAPIC per vCPU; using its timer beats PIT
# polling and gives proper time handling. Without it the kernel disables
# the apic facility entirely ("APIC: Switched APIC routing to: noop").
# X86_IO_APIC is def_bool y behind X86_LOCAL_APIC and cannot be pinned
# off; no IO-APIC is discovered without ACPI/MPS tables, so the IRQ path
# stays the emulated i8259 PIC.
CONFIG_X86_LOCAL_APIC=y
CONFIG_PRINTK_TIME=y

# ── PVH direct boot + KVM paravirt time ────────────────────────────────
CONFIG_PVH=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y
# Deterministic boot: the ELF entry point is the load address. KASLR is
# off because RELOCATABLE stays not-set (verified in the built config);
# RANDOMIZE_BASE is unreachable behind it.

# ── single vCPU, flat memory: skips SMP/NUMA/MCE bring-up ──────────────
# (HIGHMEM does not exist on x86_64; NUMA is unreachable behind SMP=n,
# the line is kept to document the intent.)
CONFIG_SMP=n
CONFIG_NUMA=n
CONFIG_X86_MCE=n

# ── virtio (mmio transport only, no PCI) ────────────────────────────────
# BLK_DEV/NETDEVICES are menu gates: without them VIRTIO_BLK/VIRTIO_NET are
# silently dropped by olddefconfig (allnoconfig turns the menus off).
# There is no VIRTIO_RNG symbol; HW_RANDOM_VIRTIO below is the real
# virtio-rng gate.
CONFIG_PCI=n
CONFIG_BLK_DEV=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y

# ── networking (user-space NAT behind virtio-net) ───────────────────────
# The VMM's user-space netstack hands out an IPv4 address and DNS
# resolver. IPV6 and PERF_EVENTS default to y upstream and cannot be
# pinned off; the integration suite, boot included, passes with both.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# ── filesystems ─────────────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y

# ── memory hotplug: boot floor + grow on demand ───────────────────────
# The VMM maps the full memory cap as one lazy KVM slot but declares only
# a boot floor in the PVH memmap; the portagent hot-adds the rest in
# section-sized chunks when a workload's MemAvailable descends below a
# low-water mark, up to the cap the VMM passes it. Memory that is never
# probed stays a lazy zero mapping on the host: resident cost tracks what
# the workload actually touches, not the cap. ARCH_MEMORY_PROBE is
# def_bool y behind MEMORY_HOTPLUG and provides /sys/devices/system/memory/
# probe; the portagent onlines each probed block itself.
CONFIG_MEMORY_HOTPLUG=y
CONFIG_ARCH_MEMORY_PROBE=y

# ── vsock: per-command host channels ───────────────────────────────────
# The userspace device (see src/virtio/vsock.rs) bridges each guest
# vsock connection to a host channel the VMM owns — one socket per
# command, concurrent foreground execution with per-connection
# attribution. af_vsock in the guest; no host kernel vsock anywhere.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# ── process/exec plumbing ───────────────────────────────────────────────
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_EPOLL=y

# ── console ─────────────────────────────────────────────────────────────
# VT defaults to y upstream and cannot be pinned off. The printk console
# is the SERIAL port (console=ttyS0): the session transport is vsock (the
# guest's vsockd bridges it to a pty), so kernel messages must never ride
# the session stream — the VMM's 8250 stub serves LSR=TX-ready and either
# mirrors the bytes at -v or absorbs them. The earlycon (8250_early.c
# builds under SERIAL_8250) carries the earliest boot output and hands
# over to the ttyS0 console when the driver comes up.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ── keep it small and quiet ─────────────────────────────────────────────
# COREDUMP defaults to y upstream and ELF_CORE cannot be pinned off
# (~4k of text, no security boundary).
CONFIG_MODULES=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_ACPI=n
# /dev/mem: the crafted export/resize helpers mmap the hypercall page
# through it (userspace MMIO write → KVM exit → VMM handler).
CONFIG_DEVMEM=y
